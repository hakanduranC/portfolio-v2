    .edu-card-grid:hover h3 { color: var(--color-primary); }
    .edu-card-grid:hover .edu-logo-wrap {
      background: rgba(255, 248, 235, 0.95);
      box-shadow: 0 0 0 2px rgba(201, 166, 107, 0.3);
    }

    /* ═══ REFERENCES — SEALED BADGE ═══ */
    .ref-seal-card {
      display: flex;
      align-items: center;
      gap: 20px;
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: 16px;
      padding: 28px;
      cursor: pointer;
      text-align: left;
      transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      width: 100%;
      position: relative;
    }
    .ref-seal-card:hover {
      transform: translateY(-4px);
      border-color: rgba(201, 166, 107, 0.4);
      box-shadow: 0 12px 40px -10px rgba(201, 166, 107, 0.15);
    }
    .ref-seal {
      flex-shrink: 0;
    }
    .ref-seal-ring {
      width: 64px;
      height: 64px;
      border-radius: 50%;
      border: 2px solid var(--color-primary);
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      animation: seal-pulse 3s ease-in-out infinite;
    }
    .ref-seal-ring::before {
      content: '';
      position: absolute;
      inset: -6px;
      border-radius: 50%;
      border: 1px dashed rgba(201, 166, 107, 0.3);
    }
    .ref-seal-inner {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: rgba(201, 166, 107, 0.15);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--color-primary);
    }
    @keyframes seal-pulse {
      0%, 100% { box-shadow: 0 0 0 0 rgba(201, 166, 107, 0.15); }
      50% { box-shadow: 0 0 0 8px rgba(201, 166, 107, 0); }
    }
    .ref-open-hint {
      position: absolute;
      top: 16px;
      right: 16px;
      color: var(--color-muted);
      opacity: 0;
      transition: opacity 0.3s;
    }
    .ref-seal-card:hover .ref-open-hint {
      opacity: 1;
      color: var(--color-primary);
    }

    /* ═══ REFERENCE MODAL ═══ */
    .ref-modal {
      position: fixed;
      inset: 0;
      z-index: 200;
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s;
    }
    .ref-modal.open {
      opacity: 1;
      pointer-events: all;
    }
    .ref-modal-backdrop {
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, 0.8);
      backdrop-filter: blur(8px);
