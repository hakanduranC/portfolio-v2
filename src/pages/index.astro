      width: 36px;
      height: 36px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 8px;
      background: none;
      border: none;
      color: var(--color-muted);
      cursor: pointer;
      transition: all 0.2s;
    }
    .ref-modal-close-btn:hover {
      color: var(--color-foreground);
      background: var(--color-surface-light);
    }
    .ref-modal-body {
      flex: 1;
      padding: 16px;
      overflow: hidden;
    }

    /* ═══ SCROLL-REVEAL ANIMATIONS ═══ */
    .reveal-card {
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
