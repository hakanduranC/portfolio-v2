---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import BlogPostCard from '../components/BlogPostCard.astro';
import SkillBadge from '../components/SkillBadge.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const allPosts = await getCollection('blog');
const recentPosts = allPosts
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const experience = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);
const education = (await getCollection('education')).sort((a, b) => a.data.order - b.data.order);
const referenceEntries = (await getCollection('references')).sort((a, b) => a.data.order - b.data.order);
const skillGroups = (await getCollection('skills')).sort((a, b) => a.data.order - b.data.order);

const stats = [
  { value: '3+', label: 'Years Experience' },
  { value: 'M.Sc.', label: 'TUM Munich' },
  { value: '15+', label: 'Technologies' },
  { value: '3', label: 'Countries Lived' },
];

const marqueeSkills = [
  'Python', 'Django', 'React', 'Angular', 'Spring Boot', 'Docker', 'Kubernetes',
  'AWS', 'Terraform', 'PostgreSQL', 'GitHub Actions', 'GitLab CI', 'LangChain',
  'DevOps', 'CI/CD', 'Microservices', 'Node.js', 'Weaviate', 'Helm',
  'Prometheus', 'Grafana', 'REST APIs', 'Flask', '.NET Core', 'MySQL',
];
---

<BaseLayout
  title="Hakan Duran — Full Stack Developer"
  description="Full Stack Developer & Computer Scientist. M.Sc. Computer Science at Technical University of Munich. Building robust applications with modern technologies."
>

  <!-- ═══════════════ HERO ═══════════════ -->
  <section class="min-h-screen flex items-center pt-16 relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none overflow-hidden">
      <div class="absolute w-[600px] h-[600px] rounded-full bg-primary/[0.05] top-[-20%] right-[-10%] blur-[120px]"></div>
      <div class="absolute w-[400px] h-[400px] rounded-full bg-primary/[0.03] bottom-[-15%] left-[-10%] blur-[100px]"></div>
    </div>
    <div class="sec-container relative z-10 w-full">
      <div class="grid grid-cols-1 md:grid-cols-[1fr_0.8fr] gap-12 md:gap-16 items-center">
        <div class="flex flex-col gap-5 order-2 md:order-1 text-center md:text-left">
          <span class="hero-anim inline-flex items-center gap-2.5 text-xs font-semibold uppercase tracking-[0.15em] text-primary justify-center md:justify-start" style="animation-delay:0.15s">
            <span class="w-6 h-px bg-primary hidden md:block"></span>
            Full Stack Developer
          </span>
          <h1 class="hero-anim font-[var(--font-display)] font-bold leading-[0.95] tracking-tight" style="font-size:clamp(3.5rem,9vw,7rem);animation-delay:0.25s">
            <span class="block">HAKAN</span>
            <span class="block text-primary">DURAN</span>
          </h1>
          <p class="hero-anim text-muted text-base md:text-lg" style="animation-delay:0.45s">Computer Engineer &amp; Scientist</p>
          <p class="hero-anim text-muted-light text-sm md:text-base leading-relaxed max-w-lg mx-auto md:mx-0" style="animation-delay:0.55s">
            Building intelligent systems that scale. Experienced in cloud infrastructure, DevOps pipelines, and AI-powered automation. Currently pursuing M.Sc. in Computer Science at the Technical University of Munich.
          </p>
          <div class="hero-anim flex items-center gap-3 flex-wrap justify-center md:justify-start" style="animation-delay:0.65s">
            <a href="https://github.com/hakanduranC" target="_blank" rel="noopener" class="social-pill">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
              GitHub
            </a>
            <a href="https://linkedin.com/in/hakanduran98" target="_blank" rel="noopener" class="social-pill">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              LinkedIn
            </a>
            <a href="mailto:contact@hakanduran.me" class="social-pill">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M22 7l-10 6L2 7"/></svg>
              Email
            </a>
          </div>
        </div>
        <div class="hero-anim relative order-1 md:order-2 max-w-xs md:max-w-none mx-auto" style="animation-delay:0.35s">
          <div class="absolute inset-[-1px] rounded-2xl bg-gradient-to-br from-primary/20 to-transparent z-0"></div>
          <Image src="/profile.jpg" alt="Hakan Duran" width={400} height={500} class="relative z-10 w-full rounded-2xl border border-border object-cover" loading="eager" />
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════ STATS ═══════════════ -->
  <section class="py-10 bg-surface border-y border-border">
    <div class="sec-container grid grid-cols-2 md:grid-cols-4">
      {stats.map((stat, i) => (
        <div class="text-center py-4 px-4 relative">
          {i < stats.length - 1 && <div class="hidden md:block absolute right-0 top-1/2 -translate-y-1/2 w-px h-8 bg-border"></div>}
          <div class="font-[var(--font-display)] text-2xl md:text-3xl font-bold tracking-tight text-primary">{stat.value}</div>
          <div class="text-xs uppercase tracking-widest text-muted mt-1">{stat.label}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- ═══════════════ SKILLS MARQUEE ═══════════════ -->
  <section class="py-6 border-b border-border bg-surface/30 overflow-hidden">
    <div class="flex animate-marquee whitespace-nowrap">
      {[...marqueeSkills, ...marqueeSkills].map((s) => (
        <span class="mx-6 text-lg font-[var(--font-display)] text-muted/30 hover:text-primary transition-colors cursor-default">{s}</span>
      ))}
    </div>
  </section>

  <!-- ═══════════════ EDUCATION ═══════════════ -->
  <section id="education" class="py-section bg-surface/20 border-y border-border">
    <div class="sec-container">
      <div class="section-heading">
        <h2 class="font-[var(--font-display)] text-3xl md:text-4xl font-bold tracking-tight">
          <span class="text-primary">Education</span>
        </h2>
        <p class="text-muted-light mt-2">Academic background and qualifications</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-3 reveal-group">
        {education.map((edu, i) => (
          <div class="edu-card-grid reveal-card" style={`--i:${i}`}>
            <div class="edu-logo-wrap mb-4">
              <img src={edu.data.logo} alt={edu.data.institution} class="edu-logo" width="44" height="44" loading="lazy" />
            </div>
            <h3 class="font-[var(--font-display)] text-base font-semibold mb-1">{edu.data.institution}</h3>
            <div class="text-[13px] text-primary font-medium mb-1">{edu.data.degree}</div>
            {edu.data.focus && <div class="text-xs text-muted-light mb-3">{edu.data.focus}</div>}
            <div class="mt-auto pt-3 border-t border-border flex justify-between text-xs text-muted">
              <span>{edu.data.period}</span>
              <span>{edu.data.location}</span>
            </div>
          </div>
        ))}
      </div>

      <!-- Coursework + Languages -->
      <div class="mt-6 bg-surface border border-border rounded-2xl p-6">
        <h4 class="text-sm font-semibold text-muted-light mb-4 uppercase tracking-wider">Recent Coursework</h4>
        <div class="flex flex-wrap gap-2 reveal-chips">
          {['Advanced Topics of SW Engineering', 'Requirements Engineering', 'Fundamentals of AI',
            'Computational Surgery', 'Resilient Cognitive Systems', 'DevOps Engineering',
            'Protein Prediction', 'AWS Cloud Practitioner'].map((course, i) => (
            <span class="coursework-chip text-xs px-3 py-1.5 rounded-lg bg-background border border-border text-muted-light transition-all hover:text-primary hover:border-primary/30 cursor-default" style={`--i:${i}`}>{course}</span>
          ))}
        </div>
        <div class="flex items-center gap-3 mt-5 pt-4 border-t border-border">
          <svg class="w-4 h-4 text-primary flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          <span class="text-xs text-muted-light"><span class="text-foreground font-medium">Turkish</span> (native) &middot; <span class="text-foreground font-medium">English</span> (C1 certified) &middot; <span class="text-foreground font-medium">German</span> (A2 in use)</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════ WORK EXPERIENCE ═══════════════ -->
  <section id="experience" class="py-section">
    <div class="sec-container">
      <div class="section-heading">
        <h2 class="font-[var(--font-display)] text-3xl md:text-4xl font-bold tracking-tight">
          Work <span class="text-primary">Experience</span>
        </h2>
        <p class="text-muted-light mt-2">My professional journey through different companies and roles</p>
      </div>

      <div class="exp-list reveal-group">
        {experience.map((job, i) => (
          <div class="exp-item reveal-card" style={`--i:${i}`}>
            <div class="flex flex-wrap justify-between items-center gap-2 mb-1">
              <div class="flex items-center gap-3">
                <div class="exp-logo-wrap"><img src={job.data.logo} alt={job.data.company} class="exp-logo" width="36" height="36" loading="lazy" /></div>
                <h3 class="font-[var(--font-display)] text-lg md:text-xl font-semibold">{job.data.company}</h3>
              </div>
              <span class="text-sm text-muted">{job.data.period}</span>
            </div>
            <div class="text-sm text-primary font-medium mb-1">
              {job.data.role}<span class="inline-block text-[11px] font-semibold px-2 py-0.5 ml-2 bg-primary/15 text-primary rounded">{job.data.type}</span>
            </div>
            <div class="text-xs text-muted mb-4">{job.data.location}</div>
            <ul class="exp-bullets">
              {job.data.bullets.map((b) => (
                <li set:html={b} />
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════ FEATURED PROJECTS ═══════════════ -->
  <section id="projects" class="py-section bg-surface/20 border-y border-border">
    <div class="sec-container">
      <div class="section-heading">
        <h2 class="font-[var(--font-display)] text-3xl md:text-4xl font-bold tracking-tight">
          <span class="text-primary">Projects</span>
        </h2>
        <p class="text-muted-light mt-2">Technical projects showcasing full-stack development and DevOps</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3 reveal-group">
        {featuredProjects.map((project, i) => (
          <div class="project-card group reveal-card" style={`--i:${i}`}>
            {project.data.logo && (
              <div class="project-logo-wrap">
                <img src={project.data.logo} alt="" class="project-logo" width="80" height="44" loading="lazy" />
              </div>
            )}
            <div class="flex justify-between items-start gap-3 mb-1">
              <h3 class="font-[var(--font-display)] text-lg font-semibold transition-colors group-hover:text-primary">{project.data.title}</h3>
              <span class="text-xs text-muted whitespace-nowrap flex-shrink-0 mt-1">{project.data.period}</span>
            </div>
            {project.data.context && (
              <div class="text-xs font-medium text-primary mb-2">{project.data.context}</div>
            )}
            <p class="text-[13.5px] text-muted-light leading-[1.65] mb-4">{project.data.description}</p>
            <div class="flex flex-wrap gap-[6px] mt-auto">
              {project.data.tags.map((tag) => (
                <span class="text-[11px] font-medium px-2.5 py-1 rounded-md bg-surface-light border border-border text-muted-light transition-all group-hover:text-primary group-hover:border-primary/30 cursor-default">{tag}</span>
              ))}
            </div>
            {(project.data.url || project.data.repo) && (
              <div class="flex items-center gap-3 mt-4 pt-3 border-t border-border">
                {project.data.url && (
                  <a href={project.data.url} target="_blank" rel="noopener noreferrer" class="project-link">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                    <span>Visit</span>
                  </a>
                )}
                {project.data.repo && (
                  <a href={project.data.repo} target="_blank" rel="noopener noreferrer" class="project-link">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
                    <span>Source</span>
                  </a>
                )}
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════ TECHNICAL SKILLS ═══════════════ -->
  <section id="skills" class="py-section">
    <div class="sec-container">
      <div class="section-heading">
        <h2 class="font-[var(--font-display)] text-3xl md:text-4xl font-bold tracking-tight">
          Technical <span class="text-primary">Skills</span>
        </h2>
        <p class="text-muted-light mt-2">Technologies and tools I work with</p>
      </div>
      <div class="skills-grid reveal-group">
        {skillGroups.map((group, i) => (
          <div class="skill-card reveal-card" style={`--i:${i}`}>
            <div class="flex items-center gap-2.5 mb-3">
              <div class="skill-card-icon">
                {group.data.icon === 'code' && <svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>}
                {group.data.icon === 'layers' && <svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>}
                {group.data.icon === 'cloud' && <svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/></svg>}
                {group.data.icon === 'cpu' && <svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><path d="M15 2v2"/><path d="M15 20v2"/><path d="M2 15h2"/><path d="M2 9h2"/><path d="M20 15h2"/><path d="M20 9h2"/><path d="M9 2v2"/><path d="M9 20v2"/></svg>}
                {group.data.icon === 'book' && <svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>}
                {group.data.icon === 'globe' && <svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>}
                {group.data.icon === 'hobby' && <svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>}
              </div>
              <h3 class="font-[var(--font-display)] text-[15px] font-semibold">{group.data.title}</h3>
            </div>
            <div class="flex flex-wrap gap-[6px]">
              {group.data.items.map((skill) => (
                <span class="skill-chip">{skill}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════ REFERENCES ═══════════════ -->
  <section id="references" class="py-section">
    <div class="sec-container">
      <div class="section-heading">
        <h2 class="font-[var(--font-display)] text-3xl md:text-4xl font-bold tracking-tight">
          <span class="text-primary">References</span>
        </h2>
        <p class="text-muted-light mt-2">Official employer testimonials</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-3 reveal-group">
        {referenceEntries.map((ref, i) => (
          <button class="ref-seal-card reveal-card" style={`--i:${i}`} data-ref-title={`${ref.data.label} — ${ref.data.company}`} data-ref-pdf={ref.data.pdf} type="button">
            <div class="ref-seal">
              <div class="ref-seal-ring">
                <div class="ref-seal-inner">
                  <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                </div>
              </div>
            </div>
            <div class="flex-1 text-left">
              <div class="text-xs text-muted uppercase tracking-wider mb-1">{ref.data.label}</div>
              <h3 class="font-[var(--font-display)] text-lg font-semibold mb-1">{ref.data.company}</h3>
              <p class="text-[13px] text-muted-light leading-relaxed mb-2">"{ref.data.quote}"</p>
              <div class="flex items-center gap-3 text-xs text-muted">
                <span>{ref.data.person}</span>
                <span class="text-border">|</span>
                <span>{ref.data.date}</span>
              </div>
            </div>
            <div class="ref-open-hint">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            </div>
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- Reference PDF Modal -->
  <div id="ref-modal" class="ref-modal">
    <div class="ref-modal-backdrop" id="ref-modal-backdrop"></div>
    <div class="ref-modal-content">
      <div class="ref-modal-header">
        <h3 id="ref-modal-title" class="font-[var(--font-display)] font-semibold text-lg"></h3>
        <div class="flex items-center gap-2">
          <a id="ref-modal-download" href="" download class="ref-modal-btn">
