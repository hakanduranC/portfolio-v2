    .edu-card-grid:hover {
      transform: translateY(-4px);
      border-color: rgba(201, 166, 107, 0.3);
      box-shadow: 0 10px 36px -10px rgba(201, 166, 107, 0.1), 0 8px 30px -10px rgba(0,0,0,0.4);
