      color: var(--color-primary);
    }

    /* ═══ EDUCATION CARDS (GRID) ═══ */
    .edu-logo-wrap {
      width: 56px;
      height: 56px;
      border-radius: 12px;
      background: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
