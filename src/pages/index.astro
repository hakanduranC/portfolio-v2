      transform: translateY(20px);
      animation: hero-reveal 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    @keyframes hero-reveal { to { opacity: 1; transform: translateY(0); } }

    /* ═══ EXPERIENCE — LEFT TIMELINE ═══ */
    .exp-list {
      position: relative;
      padding-left: 32px;
    }
    /* Static gradient line */
    .exp-list::before {
      content: '';
      position: absolute;
      left: 5px;
      top: 8px;
      bottom: 8px;
      width: 1px;
      background: linear-gradient(to bottom, var(--color-primary), var(--color-border), var(--color-border));
      border-radius: 1px;
    }
    .exp-item {
      position: relative;
      padding-bottom: 36px;
    }
    .exp-item:last-child { padding-bottom: 0; }
    .exp-item::before {
      content: '';
      position: absolute;
      left: -32px;
      top: 8px;
      width: 12px;
      height: 12px;
      background: var(--color-primary);
      border-radius: 50%;
      border: 3px solid var(--color-background);
      z-index: 2;
      box-shadow: 0 0 12px rgba(201, 166, 107, 0.3);
    }
    .exp-bullets {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .exp-bullets li {
      font-size: 14px;
      color: var(--color-muted-light);
      line-height: 1.6;
      padding-left: 18px;
      position: relative;
    }
    .exp-bullets li::before {
      content: '\25B9';
      position: absolute;
      left: 0;
      color: var(--color-primary);
      font-size: 12px;
    }
    .exp-item { transition: all 0.3s ease; }
    .exp-item:hover .exp-logo-wrap {
      background: rgba(255, 248, 235, 0.95);
      box-shadow: 0 0 0 2px rgba(201, 166, 107, 0.3);
    }
    .exp-logo-wrap {
      width: 48px;
      height: 48px;
      border-radius: 10px;
      background: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      padding: 3px;
      overflow: hidden;
      transition: all 0.3s ease;
    }
    .exp-logo {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    /* ═══ PROJECT CARDS ═══ */
    .project-logo-wrap {
      width: 80px;
      height: 52px;
      border-radius: 10px;
      background: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 16px;
      padding: 4px;
      overflow: hidden;
      transition: all 0.3s ease;
    }
    .project-card:hover .project-logo-wrap {
      background: rgba(255, 248, 235, 0.95);
      box-shadow: 0 0 0 2px rgba(201, 166, 107, 0.3);
    }
    .project-logo {
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
    }
    .project-card {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: 16px;
      padding: 28px;
      display: flex;
      flex-direction: column;
      transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .project-card:hover {
      transform: translateY(-6px);
      border-color: rgba(201, 166, 107, 0.35);
      box-shadow: 0 12px 40px -10px rgba(201, 166, 107, 0.1), 0 8px 30px -10px rgba(0,0,0,0.5);
