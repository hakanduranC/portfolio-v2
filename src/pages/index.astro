      transform: scale(1) translateY(0);
    }
    .ref-modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 16px 24px;
      border-bottom: 1px solid var(--color-border);
      flex-shrink: 0;
