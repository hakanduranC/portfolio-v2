      font-weight: 500;
      color: var(--color-muted);
      transition: color 0.2s;
      text-decoration: none;
    }
    .project-link:hover {
      color: var(--color-primary);
    }

    /* ═══ SKILL CARDS ═══ */
    .skills-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
    }
    @media (max-width: 900px) {
