---
interface Props {
  title: string;
  description: string;
  date: Date;
  tags: string[];
  slug: string;
  readingTime?: string;
}

const { title, description, date, tags, slug, readingTime } = Astro.props;

const formatted = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<a href={`/blog/${slug}`} class="group block bg-surface border border-border rounded-xl p-6 transition-all duration-300 hover:border-primary/30 hover:shadow-lg hover:shadow-primary-glow">
  <div class="flex items-center gap-3 mb-3 text-xs text-muted">
    <time datetime={date.toISOString()}>{formatted}</time>
    {readingTime && (
      <>
        <span class="text-border">|</span>
        <span>{readingTime}</span>
      </>
    )}
  </div>
  <h3 class="font-[var(--font-display)] text-lg font-semibold text-foreground tracking-tight mb-2 group-hover:text-primary transition-colors">
    {title}
  </h3>
  <p class="text-sm text-muted-light leading-relaxed mb-4">{description}</p>
  <div class="flex flex-wrap gap-1.5">
    {tags.map((tag) => (
      <span class="text-xs font-medium px-2 py-0.5 rounded-md bg-surface-light text-muted">
        {tag}
      </span>
    ))}
  </div>
</a>
