---
interface Props {
  title: string;
  description: string;
  tags: string[];
  url?: string;
  repo?: string;
  slug: string;
}

const { title, description, tags, url, repo, slug } = Astro.props;
---

<article class="group bg-surface border border-border rounded-xl p-6 flex flex-col gap-4 transition-all duration-300 hover:border-primary/30 hover:shadow-lg hover:shadow-primary-glow">
  <div class="flex items-start justify-between gap-3">
    <h3 class="font-[var(--font-display)] text-lg font-semibold text-foreground tracking-tight">
      {title}
    </h3>
    <div class="flex gap-2 opacity-0 group-hover:opacity-100 transition-opacity">
      {repo && (
        <a href={repo} target="_blank" rel="noopener" class="p-1.5 rounded-md hover:bg-surface-light transition-colors" aria-label="View source">
          <svg class="w-4 h-4 text-muted hover:text-primary" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
        </a>
      )}
      {url && (
        <a href={url} target="_blank" rel="noopener" class="p-1.5 rounded-md hover:bg-surface-light transition-colors" aria-label="View demo">
          <svg class="w-4 h-4 text-muted hover:text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        </a>
      )}
    </div>
  </div>
  <p class="text-sm text-muted-light leading-relaxed flex-1">{description}</p>
  <div class="flex flex-wrap gap-1.5 mt-auto pt-2">
    {tags.map((tag) => (
      <span class="text-xs font-medium px-2.5 py-1 rounded-md bg-surface-light text-muted transition-colors group-hover:bg-primary-dim group-hover:text-primary">
        {tag}
      </span>
    ))}
  </div>
</article>
