---
interface Props {
  title: string;
  number?: string;
}

const { title, number } = Astro.props;
---

<section class="mb-16">
  <div class="flex items-baseline gap-4 mb-8 border-b border-border pb-4">
    {number && (
      <span class="font-[var(--font-display)] text-3xl text-primary/20">{number}</span>
    )}
    <h2 class="font-[var(--font-display)] text-2xl font-semibold tracking-tight">{title}</h2>
  </div>
  <slot />
</section>
